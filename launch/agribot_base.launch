<launch>

  <!-- ###################################### -->
  <!-- ###### Arguments and parameters ###### -->
  <!-- ###################################### -->

  <!-- Main arguments -->
  <arg name="launch_type" default="hal" />
  <arg name="path_synchronization" default="true" />
  <arg name="monitoring" default="true" />
  <arg name="perception_sensors" default="false" />

  <!-- Simulation arguments -->
  <arg name="world" default="empty" />
  <arg name="gazebo_gui" default="false" />
  <arg name="gazebo_debug" default="false" />

  <!-- Visualization arguments -->
  <arg name="vis" default="false" />
  <arg name="mapviz" default="false" />
  <arg name="rviz_models" default="false" />

  <!-- Agribot commander arguments -->
  <arg name="cmd_vel_arbiter_starting_state" default="stop" />

  <!-- Agribot map arguments  -->
  <arg name="map_file" default="$(find agribot_map)/maps/moderna.yaml" />

  <!-- Agribot localization parameters -->
  <arg name="use_ukf" default="false" />
  <arg name="navsat_transform_magnetic_declination_radians" default="0.0" />

  <!-- Agribot localization - wheel odometry parameters -->
  <arg name="wheel_radius" default="0.16" />
  <arg name="chassis_length" default="2.1" />
  <arg name="orientation_covariance" default="0.01" />
  <arg name="position_covariance" default="0.01" />
  <arg name="linear_velocity_x_covariance" default="0.0001" />
  <arg name="linear_velocity_y_covariance" default="0.0001" />
  <arg name="angular_velocity_z_covariance" default="0.0001" />

  <!-- Agribot obstacle detection parameters -->
  <arg name="robot_length" default="4.3" />
  <arg name="robot_width" default="1.4" />
  <arg name="detection_robot_length_offset" default="0.3" />
  <arg name="detection_robot_width_offset" default="0.3" />

  <!-- Firebase user id argument -->
  <arg name="uid" value="xhMK5aMLSZOo5rsS67xlTw9dg5o1" />
  <arg name="rsn" value="ADI75R1" />


  <!-- ########################## -->
  <!-- ###### Launch files ###### -->
  <!-- ########################## -->

  <!-- Agribot commander -->
  <include file="$(find agribot_commander)/launch/agribot_commander.launch" />

  <!-- Agribot description -->
  <include file="$(find agribot_description)/launch/agribot_description.launch">
    <arg name="perception_sensors" value="$(arg perception_sensors)" />
  </include>

  <!-- Agribot localization -->
  <include file="$(find agribot_localization)/launch/agribot_localization.launch">
    <arg name="sim" value="$(eval arg('launch_type') == 'sim')" />
    <arg name="use_ukf" value="$(arg use_ukf)" />
    <arg name="wheel_radius" value="$(arg wheel_radius)" />
    <arg name="chassis_length" value="$(arg chassis_length)" />
    <arg name="orientation_covariance" value="$(arg orientation_covariance)" />
    <arg name="position_covariance" value="$(arg position_covariance)" />
    <arg name="linear_velocity_x_covariance" value="$(arg linear_velocity_x_covariance)" />
    <arg name="linear_velocity_y_covariance" value="$(arg linear_velocity_y_covariance)" />
    <arg name="angular_velocity_z_covariance" value="$(arg angular_velocity_z_covariance)" />
  </include>

  <!-- Agribot map -->
  <include file="$(find agribot_map)/launch/agribot_map.launch">
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="uid" value="$(arg uid)" />
    <arg name="path_synchronization" value="$(arg path_synchronization)" />
  </include>

  <!-- Agribot monitoring (send data to Cloud Firestore) -->
  <include file="$(find agribot_monitoring)/launch/agribot_monitoring.launch">
    <arg name="rsn" value="$(arg rsn)" />
    <arg name="monitoring" value="$(arg monitoring)" />
  </include>

  <!-- Agribot navigation -->
  <include file="$(find agribot_navigation)/launch/agribot_navigation.launch">
    <arg name="cmd_vel_arbiter_starting_state" value="$(arg cmd_vel_arbiter_starting_state)" />
  </include>

  <!-- Agribot obstacle detection -->
  <include if="$(arg perception_sensors)" file="$(find agribot_obstacle_detection)/launch/agribot_obstacle_detection.launch">
    <arg name="robot_length" value="$(arg robot_length)" />
    <arg name="robot_width" value="$(arg robot_width)" />
    <arg name="detection_robot_length_offset" value="$(arg detection_robot_length_offset)" />
    <arg name="detection_robot_width_offset" value="$(arg detection_robot_width_offset)" />
  </include>

  <!-- Agribot teleop -->
  <include file="$(find agribot_teleop)/launch/agribot_teleop.launch">
    <arg name="chassis_length" value="$(arg chassis_length)" />
  </include>


  <!-- Agribot simulation -->
  <include if="$(eval arg('launch_type') == 'sim')" file="$(find agribot_simulation)/launch/agribot_simulation.launch">
    <arg name="world" value="$(arg world)" />
    <arg name="gazebo_gui" default="false" />
    <arg name="gazebo_debug" default="false" />
  </include>
  <!-- or Agribot HAL -->
  <include if="$(eval arg('launch_type') == 'hal')" file="$(find hal_bringup)/launch/bringup_hal_agribot.launch">
    <arg name="manual" value="false" />
  </include>
  <!-- if launch_type is set to robomaker (or anything other than sim/hal) neither simulation nor HAL are launched -->

  <!-- Visualization -->
  <include if="$(arg vis)" file="$(find agribot_bringup)/launch/bringup_visualization.launch">
    <arg name="mapviz" value="$(arg mapviz)" />
  </include>

</launch>
