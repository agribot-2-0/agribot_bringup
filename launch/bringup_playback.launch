<launch>
  <arg name="vis" default="false" />
  <arg name="mapviz" default="false" />

  <arg name="bag_path" />
  <arg name="clock" default="false" />
  <arg name="rate" default="1.0" />

  <!-- Robot model -->
  <param name="robot_description" command="$(find xacro)/xacro '$(find agribot_description)/urdf/agribot.urdf.xacro'" />

  <!-- Sim time -->
  <param name="/use_sim_time" value="true" />

  <!-- Accumulated playback arguments (without clock settings)  -->
  <arg name="playback_args" value="-r $(arg rate) $(arg bag_path)"/>

  <!-- Bag playback - publish additional clock ON -->
  <group if="$(arg clock)">
    <node pkg="rosbag" type="play" name="player" output="screen" args="--clock $(arg playback_args)" />
  </group>

  <!-- Bag playback - publish additional clock OFF -->
  <group unless="$(arg clock)">
    <node pkg="rosbag" type="play" name="player" output="screen" args="$(arg playback_args)" />
  </group>

  <!-- Visualization -->
  <group if="$(arg vis)">
    <include file="$(find agribot_bringup)/launch/bringup_visualization.launch">
      <arg name="mapviz" value="$(arg mapviz)" />
    </include>
  </group>
</launch>