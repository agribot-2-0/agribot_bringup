<launch>

  <node pkg="mapviz" type="mapviz" name="$(anon mapviz)">
    <param name="config" value="$(find agribot_bringup)/mapviz/agribot_navigation.mvc" />
  </node>

  <node pkg="swri_transform_util" type="initialize_origin.py" name="initialize_origin" output="screen">
    <param name="local_xy_frame" value="map" />
    <param name="local_xy_origin" value="auto" />
    <param name="local_xy_navsatfix_topic" value="/agribot/gnss" />
  </node>

  <!-- GPSFix for mapviz visualization -->
  <node pkg="agribot_localization" type="rewrite_navsatfix_to_gpsfix.py" name="rewrite_navsatfix_to_gpsfix" />

</launch>
