<launch>

  <!-- Use simulation time -->
  <param name="/use_sim_time" value="true"/>

  <!-- Robomaker specific setup -->
  <arg name="vis"                       default="true"/>
  <arg name="use_perception_sensors"    default="true"/>
  <arg name="path_synchronization"      default="false"/>
  <arg name="monitoring"                default="false"/>

  <!-- Include agribot_base.launch and pass robomaker specific arguments -->
  <include file="$(find agribot_bringup)/launch/agribot_base.launch" >
    <arg name="vis"                     value="$(arg vis)"/>
    <arg name="use_perception_sensors"  value="$(arg use_perception_sensors)"/>
    <arg name="path_synchronization"    value="$(arg path_synchronization)"/>
    <arg name="monitoring"              value="$(arg monitoring)"/>
  </include>

  <!-- TODO - add automatic publication of task (if environmental variable is set) -->

</launch>
