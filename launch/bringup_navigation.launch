<launch>
  <!-- Simulation arguments -->
  <arg name="sim" default="false"/>
  <arg name="world" default="empty"/>

  <!-- Visualization arguments -->
  <arg name="vis"     default="false"/>
  <arg name="osm"     default="false"/>
  <arg name="mapviz"  default="false"/>

  <!-- State Machine argument -->
  <arg name="smach" default="false"/>

  <!-- Argument for publishing of gazebo2rviz markers -->
  <arg name="rviz_models" default="false"/>

  <!-- Pereception sensors -->
  <arg name="use_perception_sensors" default="false"/>

  <!-- Firebase user id argument -->
  <arg name="uid" value="xhMK5aMLSZOo5rsS67xlTw9dg5o1"/>
  <arg name="rsn" value="ADI75R1" />

  <!-- Robot description -->
  <include file="$(find agribot_description)/launch/robot_model.launch">
    <arg name="use_perception_sensors" value="$(arg use_perception_sensors)"/>
  </include>

  <!-- Map server -->
  <include file="$(find agribot_map)/launch/map_server.launch">
    <arg name="map_file" value="$(find agribot_map)/maps/moderna.yaml"/>
  </include>

  <!-- Path synchronization (get paths from Cloud Storage) -->
  <include file="$(find agribot_map)/launch/path_synchronization_node.launch">
    <arg name="uid" value="$(arg uid)"/>
  </include>

  <!-- Monitoring (send data to Cloud Firestore) -->
  <include file="$(find agribot_monitoring)/launch/monitoring_node.launch">
    <arg name="rsn" value="$(arg rsn)"/>
  </include>

  <!-- Navigation -->
  <include file="$(find agribot_navigation)/launch/kinematics_control.launch"/>
  
  <include file="$(find agribot_navigation)/launch/move_base.launch">
    <arg name="odom_topic" value="/agribot/odom/estimated"/>
    <arg name="cmd_vel_topic" value="/cmd_vel_navigation"/>
  </include>

  <!-- Localization -->
  <include file="$(find agribot_localization)/launch/agribot_localization.launch">
    <arg name="sim" value="$(arg sim)"/>
  </include>

  <!-- Simulation -->
  <group if="$(arg sim)">
    <!-- Gazebo -->
    <include file="$(find agribot_simulation)/launch/gazebo.launch">
      <arg name="world" value="$(arg world)"/>
    </include>
    <!-- gazebo2rviz -->
    <group if="$(arg rviz_models)">
      <!-- gazebo2rviz and static tf -->
      <include file="$(find gazebo2rviz)/launch/gazebo2rviz.launch">
        <arg name="marker_frequency" value="0.2"/>
      </include>
      <node pkg="tf" type="static_transform_publisher" name="tf_map_gazebo_world" args="0 0 0 -1.1284369 0 0 /map /gazebo_world 100" />
    </group>
  </group>
  <!-- or HAL -->
  <group unless="$(arg sim)">
    <include file="$(find hal_bringup)/launch/bringup_hal_agribot.launch">
      <arg name="manual" value="false"/>
    </include>
  </group>

  <!-- State machine -->
  <group if="$(arg smach)">
    <include file="$(find agribot_commander)/launch/agribot_commander_state_machine.launch"/>
  </group>
  <!-- or path_points_stuffer -->
  <group unless="$(arg smach)">
    <include file="$(find agribot_commander)/launch/path_points_stuffer.launch"/>
  </group>

  <!-- Teleop -->
  <include file="$(find agribot_teleop)/launch/manual_control_commander.launch" />

  <!-- Visualization -->
  <group if="$(arg vis)">
    <include file="$(find agribot_bringup)/launch/bringup_visualization.launch">
      <arg name="osm"     value="$(arg osm)"/>
      <arg name="mapviz"  value="$(arg mapviz)"/>
    </include>
  </group>

</launch>
