<launch>
    <arg name="osm" default="false" />

    <!-- rviz -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find agribot_bringup)/rviz/agribot_navigation.rviz" />

    <!-- OSM cartopgraphy -->
    <group if="$(arg osm)">
        <include file="$(find osm_cartography)/launch/viz_osm.launch" >
            <arg name="url" value="package://agribot_map/osm/drzewna.osm" />
            <arg name="frame_id" value="utm" />
        </include>
    </group>

</launch>
