<launch>
  <arg name="mapviz" default="false" />

  <!-- rviz -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find agribot_bringup)/rviz/agribot_navigation.rviz" />

  <!-- Mapviz -->
  <group if="$(arg mapviz)">
    <include file="$(find agribot_bringup)/launch/bringup_mapviz.launch" />
  </group>

  <!-- smach viewer -->
  <node name="smach_viewer" pkg="smach_viewer" type="smach_viewer.py" />

</launch>
