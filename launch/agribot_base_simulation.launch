<launch>

  <!-- Use simulation time -->
  <param name="/use_sim_time" value="true" />

  <!-- Local simulation setup -->
  <arg name="launch_type" default="sim" />
  <arg name="vis" default="true" />
  <arg name="mapviz" default="true" />
  <arg name="path_synchronization" default="false" />
  <arg name="monitoring" default="false" />

  <!-- Include agribot_base.launch and pass simulation specific arguments -->
  <include file="$(find agribot_bringup)/launch/agribot_base.launch" />

  <!-- TODO - add automatic publication of task (if environmental variable is set) -->
  <param name="task_name" value="$(env AGRIBOT_SIMULATION_TASK)"/>
  <node name="functional_test" pkg="agribot_bringup" type="agribot_functional_test.py"/>

</launch>
