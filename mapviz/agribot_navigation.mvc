capture_directory: ~
fixed_frame: map
target_frame: <none>
fix_orientation: false
rotate_90: false
enable_antialiasing: true
show_displays: true
show_status_bar: true
show_capture_tools: true
window_width: 1853
window_height: 1025
view_scale: 0.1095695
offset_x: -13.56079
offset_y: 33.57073
use_latest_transforms: true
background: "#555753"
displays:
  - type: mapviz_plugins/tile_map
    name: Map
    config:
      visible: true
      collapsed: true
      custom_sources:
        - base_url: http://localhost:8082/wmts/gm_layer/gm_grid/{level}/{x}/{y}.png
          max_zoom: 19
          name: test
          type: wmts
      bing_api_key: ""
      source: test
  - type: mapviz_plugins/path
    name: KML path
    config:
      visible: true
      collapsed: true
      topic: /agribot/move_base_monitor/path
      color: "#204a87"
  - type: mapviz_plugins/path
    name: Global path
    config:
      visible: true
      collapsed: true
      topic: /move_base/WaypointGlobalPlanner/global_plan
      color: "#19ff00"
  - type: mapviz_plugins/navsat
    name: GNSS
    config:
      visible: true
      collapsed: true
      topic: /agribot/gnss
      color: "#fce94f"
      draw_style: lines
      position_tolerance: 0
      buffer_size: 0
  - type: mapviz_plugins/navsat
    name: Local
    config:
      visible: true
      collapsed: true
      topic: /agribot/local_odom_navsatfix
      color: "#000000"
      draw_style: lines
      position_tolerance: 0
      buffer_size: 0
  - type: mapviz_plugins/odometry
    name: GPS
    config:
      visible: true
      collapsed: true
      topic: /agribot/odom/gps
      color: "#00ff00"
      draw_style: arrows
      position_tolerance: 0
      buffer_size: 1
      show_laps: false
      show_covariance: true
      show_all_covariances: false
      static_arrow_sizes: false
      arrow_size: 25
      show_timestamps: 0
  - type: mapviz_plugins/odometry
    name: raw
    config:
      visible: true
      collapsed: true
      topic: /agribot/odom/raw
      color: "#000000"
      draw_style: arrows
      position_tolerance: 0
      buffer_size: 1
      show_laps: false
      show_covariance: false
      show_all_covariances: false
      static_arrow_sizes: false
      arrow_size: 25
      show_timestamps: 0
  - type: mapviz_plugins/odometry
    name: Local
    config:
      visible: true
      collapsed: true
      topic: /agribot/odom/local
      color: "#ef2929"
      draw_style: arrows
      position_tolerance: 0
      buffer_size: 1
      show_laps: false
      show_covariance: true
      show_all_covariances: false
      static_arrow_sizes: false
      arrow_size: 29
      show_timestamps: 0
  - type: mapviz_plugins/odometry
    name: Global
    config:
      visible: true
      collapsed: true
      topic: /agribot/odom/global
      color: "#fc39ee"
      draw_style: arrows
      position_tolerance: 0
      buffer_size: 1
      show_laps: false
      show_covariance: true
      show_all_covariances: false
      static_arrow_sizes: false
      arrow_size: 29
      show_timestamps: 0
  - type: mapviz_plugins/pointcloud2
    name: Front bumper pointcloud
    config:
      visible: true
      collapsed: true
      topic: /bumper/front/lidar
      size: 3
      buffer_size: 1
      alpha: 1
      color_transformer: Flat Color
      min_color: "#00ff00"
      max_color: "#000000"
      value_min: 0
      value_max: 100
      use_rainbow: false
      use_automaxmin: false
      unpack_rgb: false
  - type: mapviz_plugins/marker
    name: Vision markers
    config:
      visible: true
      collapsed: true
      topic: /agribot/vision_markers
  - type: mapviz_plugins/marker
    name: KML Waypoints
    config:
      visible: true
      collapsed: true
      topic: /agribot/move_base_monitor/waypoints
  - type: mapviz_plugins/marker
    name: Global Planner Waypoints
    config:
      visible: true
      collapsed: true
      topic: /move_base/WaypointGlobalPlanner/waypoints
  - type: mapviz_plugins/marker
    name: Goal Range
    config:
      visible: true
      collapsed: true
      topic: /move_base/AgribotPlannerROS/goal_range
  - type: mapviz_plugins/marker
    name: Next Goal
    config:
      visible: true
      collapsed: true
      topic: /move_base/AgribotPlannerROS/next_goal
  - type: mapviz_plugins/marker
    name: Travelled Path
    config:
      visible: false
      collapsed: true
      topic: /move_base/AgribotPlannerROS/travelled_path
  - type: mapviz_plugins/marker
    name: Predicted path
    config:
      visible: false
      collapsed: true
      topic: /move_base/SimplePlannerROS/predicted_path
  - type: mapviz_plugins/path
    name: Local Path
    config:
      visible: true
      collapsed: true
      topic: /move_base/AgribotPlannerROS/local_path
      color: "#ef2929"