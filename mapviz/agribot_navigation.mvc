capture_directory: ~
fixed_frame: map
target_frame: <none>
fix_orientation: false
rotate_90: false
enable_antialiasing: true
show_displays: true
show_status_bar: true
show_capture_tools: true
window_width: 1853
window_height: 1025
view_scale: 0.01843513
offset_x: -2.656947
offset_y: 3.524748
use_latest_transforms: true
background: "#555753"
displays:
  - type: mapviz_plugins/tile_map
    name: Map
    config:
      visible: true
      collapsed: true
      custom_sources:
        - base_url: http://localhost:8082/wmts/gm_layer/gm_grid/{level}/{x}/{y}.png
          max_zoom: 19
          name: test
          type: wmts
      bing_api_key: ""
      source: test
  - type: mapviz_plugins/path
    name: KML path
    config:
      visible: true
      collapsed: true
      topic: /agribot/move_base_monitor/path
      color: "#204a87"
  - type: mapviz_plugins/path
    name: Global path
    config:
      visible: true
      collapsed: true
      topic: /move_base/WaypointGlobalPlanner/global_plan
      color: "#19ff00"
  - type: mapviz_plugins/navsat
    name: Odom base
    config:
      visible: false
      collapsed: true
      topic: /agribot/odom_base_navsatfix
      color: "#000000"
      draw_style: lines
      position_tolerance: 0
      buffer_size: 0
  - type: mapviz_plugins/odometry
    name: GPS
    config:
      visible: false
      collapsed: true
      topic: /agribot/odom/gps
      color: "#00ff00"
      draw_style: arrows
      position_tolerance: 0
      buffer_size: 1
      show_laps: false
      show_covariance: true
      show_all_covariances: false
      static_arrow_sizes: false
      arrow_size: 25
      show_timestamps: 0
  - type: mapviz_plugins/odometry
    name: raw
    config:
      visible: false
      collapsed: true
      topic: /agribot/odom/raw/from_carts_velocities
      color: "#000000"
      draw_style: arrows
      position_tolerance: 0
      buffer_size: 1
      show_laps: false
      show_covariance: false
      show_all_covariances: false
      static_arrow_sizes: false
      arrow_size: 25
      show_timestamps: 0
  - type: mapviz_plugins/odometry
    name: local
    config:
      visible: false
      collapsed: true
      topic: /agribot/odom/local
      color: "#ef2929"
      draw_style: arrows
      position_tolerance: 0
      buffer_size: 1
      show_laps: false
      show_covariance: true
      show_all_covariances: false
      static_arrow_sizes: false
      arrow_size: 29
      show_timestamps: 0
  - type: mapviz_plugins/odometry
    name: global
    config:
      visible: true
      collapsed: true
      topic: /agribot/odom/global
      color: "#fc39ee"
      draw_style: arrows
      position_tolerance: 0
      buffer_size: 1
      show_laps: false
      show_covariance: true
      show_all_covariances: false
      static_arrow_sizes: false
      arrow_size: 140
      show_timestamps: 0
  - type: mapviz_plugins/pointcloud2
    name: Front bumper pointcloud
    config:
      visible: false
      collapsed: true
      topic: /bumper/front/lidar
      size: 3
      buffer_size: 1
      alpha: 1
      color_transformer: Flat Color
      min_color: "#00ff00"
      max_color: "#000000"
      value_min: 0
      value_max: 100
      use_rainbow: false
      use_automaxmin: false
      unpack_rgb: false
  - type: mapviz_plugins/marker
    name: Vision markers
    config:
      visible: false
      collapsed: true
      topic: /agribot/vision_markers
  - type: mapviz_plugins/marker
    name: KML Waypoints
    config:
      visible: false
      collapsed: true
      topic: /agribot/move_base_monitor/waypoints
  - type: mapviz_plugins/marker
    name: Global Planner Waypoints
    config:
      visible: true
      collapsed: true
      topic: /move_base/WaypointGlobalPlanner/waypoints
  - type: mapviz_plugins/marker
    name: Goal Range
    config:
      visible: false
      collapsed: true
      topic: /move_base/AgribotPlannerROS/goal_range
  - type: mapviz_plugins/marker
    name: Next Goal
    config:
      visible: false
      collapsed: true
      topic: /move_base/AgribotPlannerROS/next_goal
  - type: mapviz_plugins/marker
    name: Travelled Path
    config:
      visible: false
      collapsed: true
      topic: /move_base/AgribotPlannerROS/travelled_path
  - type: mapviz_plugins/marker
    name: Predicted path
    config:
      visible: false
      collapsed: true
      topic: /move_base/SimplePlannerROS/predicted_path
  - type: mapviz_plugins/path
    name: Local Path
    config:
      visible: false
      collapsed: true
      topic: /move_base/AgribotPlannerROS/local_path
      color: "#ef2929"
  - type: mapviz_plugins/navsat
    name: Raw Bynav NavSatFix
    config:
      visible: true
      collapsed: true
      topic: /agribot/gnss/bynav
      color: "#00ff00"
      draw_style: points
      position_tolerance: 0
      buffer_size: 50
  - type: mapviz_plugins/navsat
    name: Filtered Bynav NavSatFix
    config:
      visible: true
      collapsed: true
      topic: /agribot/gnss/bynav/filtered
      color: "#fce94f"
      draw_style: points
      position_tolerance: 0
      buffer_size: 50
  - type: mapviz_plugins/gps
    name: Raw Bynav GPSFix
    config:
      visible: true
      collapsed: true
      topic: /agribot/gpsfix/bynav
      color: "#00ff00"
      draw_style: arrows
      position_tolerance: 0
      buffer_size: 1
      show_laps: false
      static_arrow_sizes: false
      arrow_size: 132
  - type: mapviz_plugins/gps
    name: Filtered Bynav GPSFix
    config:
      visible: true
      collapsed: true
      topic: /agribot/gpsfix/bynav/filtered
      color: "#fce94f"
      draw_style: arrows
      position_tolerance: 0
      buffer_size: 1
      show_laps: false
      static_arrow_sizes: false
      arrow_size: 129
  - type: mapviz_plugins/navsat
    name: Raw Hydrabox NavSatFix
    config:
      visible: true
      collapsed: true
      topic: /agribot/gnss/hydrabox
      color: "#f57900"
      draw_style: points
      position_tolerance: 0
      buffer_size: 50
  - type: mapviz_plugins/navsat
    name: Filtered Hydrabox NavSatFix
    config:
      visible: true
      collapsed: true
      topic: /agribot/gnss/hydrabox/filtered
      color: "#3465a4"
      draw_style: points
      position_tolerance: 0
      buffer_size: 50
  - type: mapviz_plugins/gps
    name: Raw Hydrabox GPSFix
    config:
      visible: true
      collapsed: true
      topic: /agribot/gpsfix/hydrabox
      color: "#f57900"
      draw_style: arrows
      position_tolerance: 0
      buffer_size: 1
      show_laps: false
      static_arrow_sizes: false
      arrow_size: 132
  - type: mapviz_plugins/gps
    name: Filtered Hydrabox GPSFix
    config:
      visible: true
      collapsed: true
      topic: /agribot/gpsfix/hydrabox/filtered
      color: "#3465a4"
      draw_style: arrows
      position_tolerance: 0
      buffer_size: 1
      show_laps: false
      static_arrow_sizes: false
      arrow_size: 129
  - type: mapviz_plugins/measuring
    name: new display
    config:
      visible: false
      collapsed: true
      main_color: "#000000"
      bkgnd_color: "#ffffff"
      show_bkgnd_color: true
      show_measurements: true
      font_size: 10
      alpha: 0.5